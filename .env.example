# =====================================================================
# Heritage Storytelling Agent - Environment Configuration
# =====================================================================

# Sarvam AI API Subscription Key (Get yours at https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Optional: Default Sarvam TTS voice (e.g., shubh, ratan, kavitha, priya, arvind, aditya, roopa)
SARVAM_DEFAULT_VOICE=shubh

# Optional: Sarvam TTS model (bulbul:v4-flash or bulbul:v3)
SARVAM_TTS_MODEL=bulbul:v4-flash

# Optional: Port configuration
PORT=8000
HOST=127.0.0.1
